# Credenciais locais de desenvolvimento. Nunca as reutilize em ambientes compartilhados.
ConnectionStrings__VoytekDatabase=Host=localhost;Port=5432;Database=voytek;Username=voytek;Password=voytek_local_only
POSTGRES_DB=voytek
POSTGRES_USER=voytek
POSTGRES_PASSWORD=voytek_local_only
REDIS_PASSWORD=voytek_redis_local_only
RABBITMQ_USER=voytek
RABBITMQ_PASSWORD=voytek_rabbit_local_only
Jwt__Issuer=voytek
Jwt__Audience=voytek-api
# Gere um valor aleatório com pelo menos 32 bytes para cada ambiente.
Jwt__SigningKey=replace-with-a-local-development-secret-of-at-least-32-characters
OPENAI_API_KEY=
AI__Provider=openai
AI__Model=gpt-5.6-luna
AI__TimeoutSeconds=30
AI__ProposalCacheSeconds=30
# Azure Application Insights / Azure Monitor. Leave unset in local development.
APPLICATIONINSIGHTS_CONNECTION_STRING=
